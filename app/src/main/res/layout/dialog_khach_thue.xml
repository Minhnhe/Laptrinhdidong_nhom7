<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="Chọn phòng thuê:"
        android:textColor="#424242"
        android:textSize="14sp" />

    <Spinner
        android:id="@+id/spinnerPhong"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/etHoTen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:hint="Họ và tên"
        android:inputType="textPersonName"
        android:maxLines="1" />

    <EditText
        android:id="@+id/etSdt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:hint="Số điện thoại"
        android:inputType="phone"
        android:maxLines="1" />

    <EditText
        android:id="@+id/etCmnd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:hint="CMND / CCCD"
        android:inputType="text"
        android:maxLines="1" />

    <EditText
        android:id="@+id/etQueQuan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:hint="Quê quán"
        android:inputType="text"
        android:maxLines="1" />

    <EditText
        android:id="@+id/etNgaySinh"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:hint="Ngày sinh (DD/MM/YYYY)"
        android:inputType="text"
        android:maxLines="1" />

    <EditText
        android:id="@+id/etGioiTinh"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Giới tính (Nam / Nữ)"
        android:inputType="text"
        android:maxLines="1" />

</LinearLayout>
