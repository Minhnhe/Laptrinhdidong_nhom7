<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="Chọn nhà trọ:"
        android:textColor="#424242"
        android:textSize="14sp" />

    <Spinner
        android:id="@+id/spinnerNhaTro"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/etTenPhong"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:hint="Tên phòng"
        android:inputType="text"
        android:maxLines="1" />

    <EditText
        android:id="@+id/etDienTich"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:hint="Diện tích (m2)"
        android:inputType="numberDecimal"
        android:maxLines="1" />

    <EditText
        android:id="@+id/etGiaThue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:hint="Giá thuê (VNĐ)"
        android:inputType="numberDecimal"
        android:maxLines="1" />

    <EditText
        android:id="@+id/etTrangThai"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:hint="Trạng thái (Trống / Đang thuê)"
        android:inputType="text"
        android:maxLines="1" />

    <EditText
        android:id="@+id/etMoTa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Mô tả"
        android:inputType="text"
        android:maxLines="2" />

</LinearLayout>
