<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Chọn phòng:"
            android:textColor="#424242"
            android:textSize="14sp" />

        <Spinner
            android:id="@+id/spinnerPhong"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/etThangNam"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="Tháng/Năm (MM/YYYY)"
            android:inputType="text"
            android:maxLines="1" />

        <EditText
            android:id="@+id/etChiSoDienCu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="Chỉ số điện cũ"
            android:inputType="number"
            android:maxLines="1" />

        <EditText
            android:id="@+id/etChiSoDienMoi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="Chỉ số điện mới"
            android:inputType="number"
            android:maxLines="1" />

        <EditText
            android:id="@+id/etDonGiaDien"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="Đơn giá điện (VNĐ/kWh)"
            android:inputType="numberDecimal"
            android:maxLines="1" />

        <EditText
            android:id="@+id/etChiSoNuocCu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="Chỉ số nước cũ"
            android:inputType="number"
            android:maxLines="1" />

        <EditText
            android:id="@+id/etChiSoNuocMoi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="Chỉ số nước mới"
            android:inputType="number"
            android:maxLines="1" />

        <EditText
            android:id="@+id/etDonGiaNuoc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="Đơn giá nước (VNĐ/m3)"
            android:inputType="numberDecimal"
            android:maxLines="1" />

        <EditText
            android:id="@+id/etTienPhong"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="Tiền phòng (VNĐ)"
            android:inputType="numberDecimal"
            android:maxLines="1" />

        <EditText
            android:id="@+id/etTienDichVu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="Tiền dịch vụ (VNĐ)"
            android:inputType="numberDecimal"
            android:maxLines="1" />

        <EditText
            android:id="@+id/etTrangThai"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Trạng thái (Chưa thanh toán / Đã thanh toán)"
            android:inputType="text"
            android:maxLines="1" />

    </LinearLayout>
</ScrollView>
